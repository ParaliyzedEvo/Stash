    <!-- Refresh Mode Dialog & Chips -->
    <string name="sync_switch_to_refresh_title">새로 고침으로 전환하시겠습니까?</string>
    <string name="sync_switch_to_refresh_body">Refresh mirrors your playlists and Liked songs: a song removed on the service is removed here too. Its download is deleted once every account is set to Refresh; while any account keeps songs, nothing is deleted. Songs you added in Stash are kept. Mixes follow their own Stack setting.</string>
