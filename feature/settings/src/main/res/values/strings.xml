    <string name="settings_yt_sync_dialog_title">Send your Stash plays to YouTube Music?</string>
    <string name="settings_yt_sync_dialog_body">Every track you finish listening to in Stash will be added to your YouTube Music Watch History. Your Daily Mix and other YouTube Music recommendations will learn from your Stash listening.</string>
    <string name="settings_yt_sync_dialog_how_it_works_title">How it works</string>
    <string name="settings_yt_sync_dialog_how_it_works_body">Stash uses an unofficial YouTube endpoint (the same one the YouTube Music app uses). Google tolerates this pattern for personal-use apps but could change the rules without notice. If that happens, Stash will automatically stop sending plays until a new update fixes the integration.</string>
    <string name="settings_yt_sync_dialog_risk_title">Risk</string>
    <string name="settings_yt_sync_dialog_risk_body">Rare but not zero chance of YouTube rate-limiting your account. Stash monitors for errors and pauses itself if it sees problems.</string>

