    <!-- Settings > Accounts > DisconnectAccountDialog -->
    <string name="settings_disconnect_account_title">Disconnect %1$s?</string>
    <string name="settings_disconnect_account_body">Stash signs out of %1$s on this phone and stops syncing it. Songs from %1$s still waiting to download are dropped from the queue.\n\nSongs you\'ve already downloaded stay in your library, and you can reconnect any time.</string>

    <!-- Settings > Accounts > LikeMirrorWarningDialog -->
    <string name="settings_like_mirror_warning_title">Mirror likes to %1$s?</string>
    <string name="settings_like_mirror_warning_body">Hearting a track in Stash will also Like it on %1$s, and removing a heart will remove the Like there too. Only likes you add from now on are mirrored.\n\nThis uses the same private endpoint the %1$s web player uses — not an official API. It can stop working at any time and, rarely, unofficial access can get an account flagged. Consider enabling this only on a secondary or backup account.</string>
    <string name="settings_like_mirror_warning_confirm">I understand</string>

