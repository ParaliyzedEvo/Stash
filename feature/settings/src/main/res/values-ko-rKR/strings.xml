    <!-- Settings > Accounts > DisconnectAccountDialog -->
    <string name="settings_disconnect_account_title">%1$s 연결을 끊으시겠습니까?</string>
    <string name="settings_disconnect_account_body">Stash는 이 휴대전화에서 %1$s 계정에서 로그아웃하고 동기화를 중지합니다. 다운로드 대기 중인 %1$s의 곡은 대기열에서 제거됩니다.\n\n이미 다운로드한 곡은 보관함에 그대로 남으며 언제든 다시 연결할 수 있습니다.</string>
    <!-- Settings > Accounts > LikeMirrorWarningDialog -->
    <string name="settings_like_mirror_warning_title">%1$s에 좋아요를 동기화하시겠습니까?</string>
    <string name="settings_like_mirror_warning_body">Stash에서 트랙에 하트를 누르면 %1$s에서도 좋아요가 추가되며, 하트를 취소하면 해당 서비스의 좋아요도 취소됩니다. 지금부터 추가하는 좋아요만 동기화됩니다.\n\n공식 API가 아니라 %1$s 웹 플레이어와 같은 비공개 엔드포인트를 사용합니다. 언제든 작동을 멈출 수 있으며, 드물지만 비공식 접근으로 계정이 의심 계정으로 표시될 수 있습니다. 보조 계정이나 백업 계정에서만 사용하는 것을 고려하세요.</string>
    <string name="settings_like_mirror_warning_confirm">확인했습니다</string>
